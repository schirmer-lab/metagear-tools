{
  "_comment": "Map of pipeline-produced artifacts to canonical paths under params.outdir. Used by lib/auto_reuse.sh when the user passes --reuse-outputs to skip stages whose outputs already exist on disk.",
  "_kinds": {
    "dir": "Per-sample directory. The wrapper emits --<param> <dir> only if every sample id from the input CSV has a file at <dir>/<sample_id><per_sample_suffix>.",
    "file": "Single-file artifact (catalog-level, dataset-wide). The wrapper emits --<param> <path> only if the file exists."
  },
  "reusable": [
    {
      "param": "contigs_dir",
      "kind": "dir",
      "subdir": "assemblies/contigs",
      "per_sample_suffix": ".contigs.fa.gz",
      "produced_by": "MEGAHIT"
    },
    {
      "param": "genes_dir",
      "kind": "dir",
      "subdir": "prodigal",
      "per_sample_suffix": ".all.genes.filtered.fasta",
      "produced_by": "FILTER_PRODIGAL"
    },
    {
      "param": "representative_genes",
      "kind": "file",
      "path": "catalogs/genes/all.genes.representative.fa.gz",
      "produced_by": "CLUSTER_GENES:MMSEQS_EASY_CLUSTER"
    },
    {
      "param": "representative_proteins",
      "kind": "file",
      "path": "catalogs/proteins/all.proteins.representative.fa.gz",
      "produced_by": "CLUSTER_PROTEINS:MMSEQS_EASY_CLUSTER"
    },
    {
      "param": "representative_proteins_annotations",
      "kind": "file",
      "path": "annotations/interproscan/all.proteins.FG_IPS_Pfam.tsv",
      "produced_by": "FUNCTIONALGROUP_ANNOTATION"
    },
    {
      "param": "representative_genes_tpm",
      "kind": "file",
      "path": "abundance/all.genes/all.genes.tpm.tsv",
      "produced_by": "COVERM_CONTIG_MERGE"
    },
    {
      "param": "representative_genes_rpkm",
      "kind": "file",
      "path": "abundance/all.genes/all.genes.rpkm.tsv",
      "produced_by": "COVERM_CONTIG_MERGE"
    },
    {
      "param": "representative_genes_count",
      "kind": "file",
      "path": "abundance/all.genes/all.genes.count.tsv",
      "produced_by": "COVERM_CONTIG_MERGE"
    },
    {
      "param": "chromosome_dir",
      "kind": "dir",
      "subdir": "virus/genomad/chromosome",
      "per_sample_suffix": ".chromosome.fna.gz",
      "produced_by": "GENOMAD_EXTRACT_CHROMOSOME"
    },
    {
      "param": "viral_ids_dir",
      "kind": "dir",
      "subdir": "virus/per_sample",
      "per_sample_suffix": "/virus.ids.txt",
      "produced_by": "MERGE_TABLES"
    },
    {
      "param": "plasmid_ids_dir",
      "kind": "dir",
      "subdir": "virus/per_sample",
      "per_sample_suffix": "/plasmid.ids.txt",
      "produced_by": "MERGE_TABLES"
    },
    {
      "param": "bins_dir",
      "kind": "dir",
      "subdir": "assemblies/bins",
      "per_sample_suffix": "/quality_report.tsv",
      "produced_by": "BINETTE",
      "_comment": "Per-sample Binette deliverables (MAG FASTAs + quality_report.tsv + contig_to_bin.tsv) live in assemblies/bins/<sample>/. The anchor file is the QC TSV. Pre-Binette intermediates (input_bins_quality_reports/, temporary_files/) stay in binning/binette/<sample>/ via a separate dual-publishDir branch — they are not part of the reuse contract."
    },
    {
      "param": "per_contig_tsv_dir",
      "kind": "dir",
      "subdir": "integrated_classification/per_contig",
      "per_sample_suffix": ".contigs.tsv",
      "produced_by": "MERGE_CONTIG_CLASSIFICATION"
    }
  ]
}
