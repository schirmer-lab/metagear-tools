# Runtime/build artifacts (anchored to repo root so they don't shadow templates/)
/.metagear/
/metagear
/metagear.config
/metagear.env
/metagear_*.sh
/*.config
/.nextflow*
/results/
.venv/

# macOS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local scratch — verification scripts, ad-hoc results, handoff notes
scratch/
.scratch/

# Bytecode CPython writes beside lib/*.py when main.sh invokes them.
__pycache__/
*.pyc

# Backup client litter. The TSM/Spectrum Protect client writes these into whatever
# directory it happens to run in, which includes this checkout.
/citScanOutput.xml
/dsmerror.log
/dsminstr.log
/dsminstr.log.lock
